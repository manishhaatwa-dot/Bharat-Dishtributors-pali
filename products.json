$root = (Get-Location).Path
$productRoot = Join-Path $root "assets\products"

$extensions = @(".jpg", ".jpeg", ".png", ".webp", ".gif")

$products = [ordered]@{
    cello   = @()
    bluline = @()
    patel   = @()
    pearl   = @()
    aera    = @()
    ritu    = @()
    other   = @()
}

if (-not (Test-Path $productRoot)) {
    Write-Host "ERROR: assets\products folder nahi mila."
    Write-Host "PowerShell ko website ke main folder mein kholo."
    return
}

Get-ChildItem -Path $productRoot -Recurse -File |
Where-Object {
    $extensions -contains $_.Extension.ToLowerInvariant()
} |
ForEach-Object {
    $relative = $_.FullName.Substring($root.Length + 1).Replace("\", "/")
    $parts = $relative.Split("/")

    if ($parts.Length -ge 4) {
        $category = $parts[2].ToLowerInvariant()

        if ($products.Contains($category)) {
            $products[$category] += $relative
        }
    }
}

$json = $products | ConvertTo-Json -Depth 10
$outFile = Join-Path $root "products.json"

[System.IO.File]::WriteAllText(
    $outFile,
    $json,
    (New-Object System.Text.UTF8Encoding($false))
)

Write-Host ""
Write-Host "SUCCESS! products.json ban gayi."
Write-Host "Image counts:"

foreach ($category in $products.Keys) {
    Write-Host "$category : $($products[$category].Count)"
}
